# Data.gov.in (Open Government Data Platform India) Configuration
DATA_GOV_IN_API_KEY=
VITE_DATA_GOV_IN_API_KEY=
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/

# Optional: Uncomment and set an HTTPS or relative endpoint to forward 404 hits externally.
# Not required to build or run; when unset, 404 hits still log to console, localStorage, and GA4/GTM.
# VITE_404_MONITORING_ENDPOINT=